{
    "buildCommand": "node scripts/fetch-ytdlp.js && npm run build:css",
    "outputDirectory": ".",
    "functions": {
        "api/proxy.js": {
            "maxDuration": 30
        },
        "api/ytsearch.js": {
            "includeFiles": "bin/**",
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/api/proxy", "destination": "/api/proxy" }
    ]
}
