# MsicFree Server Environment
# Copy ke .env dan edit sesuai server Anda

DB_HOST=localhost
DB_PORT=3306
DB_NAME=msicfree
DB_USER=root
DB_PASS=

# Ganti dengan random string panjang (min 32 karakter)
JWT_SECRET=GANTI-DENGAN-RANDOM-STRING-PANJANG

# Domain Cloudflare Tunnel (contoh: music.example.com)
SITE_URL=https://music.example.com

# Opsional: path ke yt-dlp dan ffmpeg (kosongkan jika sudah di PATH)
YTDLP_PATH=
FFMPEG_PATH=

# true = backup ke Firebase Firestore, false = MySQL only
FIREBASE_BACKUP=true
