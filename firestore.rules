rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own data.
    // Firestore does NOT inherit permissions into subcollections, so each
    // collection the client touches needs its own match block.

    match /users/{userId}/playlists/{playlistId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Liked songs: users/{uid}/settings/likedSongs (written by liked.js)
    match /users/{userId}/settings/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
